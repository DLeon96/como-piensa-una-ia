{
  "name": "espacio-del-significado",
  "private": true,
  "version": "1.0.0",
  "description": "Experiencia interactiva sobre embeddings para una charla de Ciencias Abiertas - UA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
